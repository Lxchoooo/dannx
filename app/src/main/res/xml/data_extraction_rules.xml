<?xml version="1.0" encoding="utf-8"?>
<!-- Solo la sesión y la foto del fondo animado quedan fuera: las colecciones
     locales viajan con el respaldo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="dannx_session.xml" />
        <exclude domain="file" path="live/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dannx_session.xml" />
        <exclude domain="file" path="live/" />
    </device-transfer>
</data-extraction-rules>
